# 실제 기관 주소·인증정보를 이 파일에 기록하거나 커밋하지 마세요.
# 기본: 미설정. 데모를 실행하려면 AI_PROVIDER=rules-demo를 명시합니다.
AI_PROVIDER=onai
ONAI_BASE_URL=
ONAI_MODEL=
# json-contract-v1은 이 앱이 정의한 계약이며 실제 온AI 규격을 뜻하지 않습니다.
ONAI_PROTOCOL=
ONAI_ADAPTER_PATH=
ONAI_API_KEY=
ONAI_TIMEOUT_MS=30000

# 인터넷 테스트: AI_PROVIDER=openai로 변경합니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=45000
# 배포 환경에서는 아래 값을 서로 다른 임의 문자열로 반드시 설정합니다.
TEST_ACCESS_TOKEN=
REVIEW_SIGNING_KEY=
# 사용자 지정 도메인 사용 시 경로 없는 HTTPS 주소
PUBLIC_APP_URL=
